[Unit]
Description=EpicBook Node.js Application
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/epicbook
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=DB_HOST={{ mysql_fqdn }}
Environment=DB_PORT=3306
Environment=DB_NAME=bookstore
Environment=DB_USER={{ mysql_admin_username }}
Environment="DB_PASSWORD={{ mysql_admin_password }}"
ExecStart=/usr/bin/node /opt/epicbook/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
